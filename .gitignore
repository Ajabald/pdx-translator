# The user's data — never committed
*.sqlite3
*.sqlite3-*
*.sqlite3.*
*.pdxproj
*.pdxproj-*
*.pdxtm
*.bak
*.migrated
Bdd/
Projects/
backups/

# The environment and the build
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
build/
dist/
*.egg-info/

# Editors and the system
.vscode/
.idea/
Thumbs.db
desktop.ini

# Other people's tools we compare ourselves against — not our code and not our
# licence. They live outside the repository (`_reference` next to it); the rules
# are insurance in case the folder is unpacked here again: one `git add -A` would
# lay a quarter of a gigabyte of somebody else's proprietary code into the
# history forever.
/LocKeysTransfer.exe
/ModTranslationHelper*/
/ModTranslationHelper*.rar

# The global check setup — the user's own, kept next to the application (see
# `settings.qa_rules_path`). The path is anchored: a file of the same name among
# the test data must not be ignored.
/qa_rules.json

# The diagnostic log and its rotation. Written next to the application, and when
# run from the sources «next to» is the root of the repository
# (`settings.app_root`).
/pdx-translator.log
/pdx-translator.log.*

# The icon preview — a derivative of tools/appicon*.svg, rebuilt by the command
# tools/make_icon.py.
/tools/appicon-preview.png

# The installer — a derivative of dist/ and installer.iss, built in CI.
/pdx-translator-setup-*.exe
