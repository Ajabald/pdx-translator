# Данные пользователя — никогда не коммитим
*.sqlite3
*.sqlite3-*
*.sqlite3.*
*.pdxproj
*.pdxproj-*
*.pdxtm
*.bak
*.migrated
Bdd/
Projects/
backups/

# Окружение и сборка
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
build/
dist/
*.egg-info/

# Редакторы и система
.vscode/
.idea/
Thumbs.db
desktop.ini

# Чужие инструменты, по которым сверяемся, — не наш код и не наша лицензия.
# Лежат за пределами репозитория (`_reference` рядом с ним); правила — страховка
# на случай, если папку снова распакуют сюда: один `git add -A` уложил бы
# четверть гигабайта чужого проприетарного кода в историю навсегда.
/LocKeysTransfer.exe
/ModTranslationHelper*/
/ModTranslationHelper*.rar

# Глобальная настройка проверок — пользовательская, лежит рядом с приложением
# (см. `settings.qa_rules_path`). Путь якорный: файл с таким же именем среди
# тестовых данных игнорировать нельзя.
/qa_rules.json

# Диагностический лог и его ротация. Пишется рядом с приложением, а при запуске
# из исходников «рядом» — это корень репозитория (`settings.app_root`).
/pdx-translator.log
/pdx-translator.log.*

# Предпросмотр иконки — производная от tools/appicon*.svg, пересобирается
# командой tools/make_icon.py.
/tools/appicon-preview.png

# Установщик — производная от dist/ и installer.iss, собирается в CI.
/pdx-translator-setup-*.exe
