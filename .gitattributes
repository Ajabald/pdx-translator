# In the repository line endings are always LF, in the working copy whatever the
# system uses. Without this, files on Windows travel into a commit with CRLF, and
# any edit by a neighbour shows up as «the whole file changed».
* text=auto eol=lf

# The Paradox localisation files the application writes itself (UTF-8 with BOM,
# LF). The repository holds none, but the rule insures against a sample being
# added by accident.
*.yml text eol=lf
*.svg text eol=lf
*.bat text eol=crlf
